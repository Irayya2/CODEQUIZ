# Copy this file to .env and fill in real values.

PORT=4000

# JWT signing secret - change to any long random string
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of email addresses allowed to log in as TEACHER.
# Any email not in this list will be rejected on the teacher login screen.
TEACHER_EMAILS=sir@example.com

# Gmail account used to SEND otp emails (create a dedicated gmail account for this).
# See mailer.js comments for how to generate an App Password.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword

# Google Gemini API key for generating quiz questions
GEMINI_API_KEY=your_gemini_api_key_here

